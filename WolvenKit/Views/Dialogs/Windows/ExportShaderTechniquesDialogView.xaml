<Window
    x:Class="WolvenKit.Views.Dialogs.Windows.ExportShaderTechniquesDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:sf="http://schemas.syncfusion.com/wpf"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:templates="clr-namespace:WolvenKit.Views.Templates"
    xmlns:convert="clr-namespace:WolvenKit.Converters"
    xmlns:ui="using:CommunityToolkit.WinUI"
    Title="Export Shader Techniques"
    MinWidth="{DynamicResource WolvenKitDialogWidthSmall}"
    MinHeight="{DynamicResource WolvenKitDialogHeightSmall}"
    Padding="{DynamicResource WolvenKitMarginTop}"
    Background="{StaticResource BackgroundColor_Control}"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterScreen"
    DataContext="{Binding RelativeSource={RelativeSource Self}, Path=ViewModel}"
    >
    <Grid
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <hc:ThemeResources />
                    <hc:Theme />
                </ResourceDictionary.MergedDictionaries>

                <convert:EnumDescriptionConverter x:Key="EnumConverter" />

                <Style
                    BasedOn="{StaticResource WolvenkitLabelStyle}"
                    TargetType="{x:Type Label}">
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="FontSize" Value="{DynamicResource WolvenKitFontSubTitle}" />
                </Style>

                <Style x:Key="TemplateStyle" TargetType="{x:Type TextBlock}">
                    <Setter Property="Padding" Value="10,5" />
                    <Setter Property="Foreground" Value="{StaticResource ForegroundColor_Grey_Dark}" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <sf:WizardControl
            CancelButtonCancelsWindow="True"
            FinishButtonClosesWindow="True"
            >
            <sf:WizardPage
                Height="Auto"
                Background="{StaticResource BackgroundColor_Control}"
                BackVisibility="Collapsed"
                CancelVisibility="Visible"
                FinishVisibility="Visible"
                HelpVisibility="Collapsed"
                NextVisibility="Collapsed"
                FinishEnabled="{Binding CanExport}"
                PageType="Exterior">
                <Grid
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource WolvenKitDialogLabelColumnWidthMedium}" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{DynamicResource WolvenKitButtonGridWidth}" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        Content="Export Format"
                        Target="{Binding ElementName=ExportFormatComboBox}"
                        />

                    <ComboBox
                        x:Name="ExportFormatComboBox"
                        Grid.Row="0"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        ItemsSource="{Binding ExportFormatList}"
                        SelectedItem="{Binding ExportFormat, Converter={StaticResource EnumConverter}}"
                        >
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Path=., Converter={StaticResource EnumConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>


                    <Label
                        Grid.Row="2"
                        Grid.Column="0"
                        Content="Shader Types"
                        Target="{Binding ElementName=ShaderTypesComboBox}"
                        />

                    <ComboBox
                        x:Name="ShaderTypesComboBox"
                        Grid.Row="2"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        ItemsSource="{Binding ShaderTypeList}"
                        SelectedItem="{Binding ShaderType, Converter={StaticResource EnumConverter}}"
                        >
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Path=., Converter={StaticResource EnumConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>


                    <Label
                        Grid.Row="4"
                        Grid.Column="0"
                        Content="Output Folder"
                        Target="{Binding ElementName=OutputFolderTextBox}"
                        />

                    <TextBox
                        x:Name="OutputFolderTextBox"
                        Grid.Row="4"
                        Grid.Column="1"
                        Margin="{StaticResource WolvenKitMarginTinyRight}"
                        Text="{Binding Folder}"
                        />

                    <Button
                        Grid.Row="4"
                        Grid.Column="2"
                        Padding="0"
                        Click="FileButton_Click">
                        <templates:IconBox
                            IconPack="Material"
                            Kind="Folder"
                            Size="{DynamicResource WolvenKitIconMicro}" />
                    </Button>

                    <Label
                        Grid.Row="6"
                        Grid.Column="0"
                        Content="Filename Template"
                        Target="{Binding ElementName=FilenameTemplateTextBox}"
                        />

                    <TextBox
                        x:Name="FilenameTemplateTextBox"
                        Grid.Row="6"
                        Grid.Column="1"
                        Margin="{StaticResource WolvenKitMarginTinyRight}"
                        Text="{Binding FilenameTemplate}"
                        />

                    <hc:ComboBox
                        x:Name="FilenameTemplateComboBox"
                        Grid.Row="6"
                        Grid.Column="2"
                        ItemsSource="{Binding FilenameTemplateList}"
                        SelectionChanged="FilenameTemplate_SelectionChanged"
                        />

                    <TextBlock
                        Grid.Row="8"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Style="{StaticResource TemplateStyle}"
                        >
                        Supported filename template variables:
                    </TextBlock>
                    <TextBlock
                        Grid.Row="9"
                        Grid.Column="0"
                        Style="{StaticResource TemplateStyle}"
                        TextAlignment="Right">
                        {SortID}<LineBreak/>
                        {Material}<LineBreak/>
                        {Index}<LineBreak/>
                        {PassIndex}<LineBreak/>
                        {Pass}<LineBreak/>
                        {VF}<LineBreak/>
                        {Flags}<LineBreak/>
                        {Type}
                    </TextBlock>
                    <TextBlock
                        Grid.Row="9"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Style="{StaticResource TemplateStyle}">
                        Composite sort value used in the data tables<LineBreak/>
                        Material name<LineBreak/>
                        Technique index number<LineBreak/>
                        Pass index number<LineBreak/>
                        Pass name<LineBreak/>
                        Vertex Factory<LineBreak/>
                        isDismembered, isPreskinned, isDisarded<LineBreak/>
                        Vertex or Pixel Shader
                    </TextBlock>

                </Grid>
            </sf:WizardPage>
            
        </sf:WizardControl>
        
    </Grid>
</Window>
